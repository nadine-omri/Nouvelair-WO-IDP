# Copie ce fichier en ".env" (meme dossier) et renseigne ta cle.
# Le fichier ".env" ne doit JAMAIS etre commite/partage (deja dans .gitignore).

# Cle gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel, seulement si VISION.provider="claude" dans configs/config.py
ANTHROPIC_API_KEY=

# Cle gratuite (tier gratuit) : https://huggingface.co/settings/tokens
# Utilisee pour le rapport IA de l'onglet "Analyse des prix" (texte seul,
# pas d'image -> pas besoin de Gemini/Claude ici).
HF_TOKEN=
